.DS_Store
__pycache__/
*.pyc

# PlatformIO build output and generated editor config (project root = repo root).
/.pio/
/.vscode/

# Casual reference photos/datasheets dropped at the repo root (hardware
# identification, etc.) are not project deliverables; keep them out of
# git history. Deliverable PDFs (e.g. the proposal) belong in docs/ and
# are not matched by this (it's root-only, no **).
/*.HEIC
/*.heic
/*.pdf
